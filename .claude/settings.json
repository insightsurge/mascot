{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Edit(NAMESPACE)",
      "Edit(man/**)",
      "Edit(renv/**)",
      "Edit(LICENSE)"
    ]
  }
}
