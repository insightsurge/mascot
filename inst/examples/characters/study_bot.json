    },
    "thinking": {
      "description": "Working on a task.",
      "status": "Working",
      "face": {
        "eyes": "scan",
        "mouth": "flat"
      }
    },
    "happy": {
      "description": "A task went well.",
      "status": "Done",
      "face": {
        "eyes": "arc",
        "mouth": "wide"
      }
    },
    "worried": {
      "description": "Something needs attention.",
      "status": "Check the result",
      "face": {
        "eyes": "slant",
        "mouth": "wavy"
      }
    },
    "celebrating": {
      "description": "A large task finished.",
      "status": "Finished",
      "face": {
        "eyes": "star",
        "mouth": "wide"
      }
    }
