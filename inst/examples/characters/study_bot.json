      "fallback": "rock",
      "tracks": {
        "hand_r.rotate": {
          "mode": "add",
          "keys": [
            [
              0,
              0
            ],
            [
              0.3,
              0.25
            ],
            [
              0.6,
              -0.25
            ],
            [
              1,
              0
            ]
          ]
