    "greet": {
      "description": "A brief greeting tilt.",
      "frames": 18,
      "tracks": {
        "head.rotate": {
          "mode": "add",
          "keys": [
            [
              0,
              0
            ],
            [
              0.3,
              0.08
            ],
            [
              1,
              0
            ]
          ]
        }
      }
    }
